PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string (local install, or free hosted: Neon / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/taskmanager?schema=public"

# Used to sign login tokens - set to a long random string
JWT_SECRET=change-me



# OpenRouter (the AI assistant)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# ElevenLabs (text to speech)
ELEVENLABS_API_KEY=

# Email (Brevo SMTP). Port 465 = SSL from the start (587 hangs on some networks)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_URL=http://localhost:5173

# Protects /api/cron/morning (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
